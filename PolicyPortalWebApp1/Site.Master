<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="PolicyPortalWebApp1.Site" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Policy Portal</title>
    <style>
        body { font-family: Arial; margin: 0; }
        header, footer { background-color: #004080; color: white; padding: 10px; }
        main { padding: 20px; }
        .topbar {
            background-color: #333;
            padding: 10px;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .topbar .left {
            font-weight: bold;
        }
        .topbar .right {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .logout-btn {
            background-color: #cc0000;
            color: white;
            border: none;
            padding: 5px 10px;
            cursor: pointer;
            font-weight: bold;
        }
        .logout-btn:hover {
            background-color: #990000;
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Header -->
        <header>
            <h2>Policy Portal</h2>
        </header>

        <!-- Top Bar with Welcome and Logout -->
        <div class="topbar">
            <div class="left">
                <asp:Label ID="lblUser" runat="server" />
            </div>
            <div class="right">
<asp:Button ID="btnLogout" runat="server" Text="Logout" OnClick="btnLogout_Click" CausesValidation="False" />
            </div>
        </div>

        <!-- Main Content Area -->
        <main>
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

        <!-- Footer -->
        <footer>
            <p>Created By Aditi Agarwal</p>
            <p>© 2025 DXC Technology</p>
        </footer>
    </form>
</body>
</html>
